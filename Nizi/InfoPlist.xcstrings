        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nizi phân tích ảnh ngay trên iPhone của bạn để tìm lại các chuyến đi và khoảnh khắc đáng nhớ. Ảnh chỉ được tải lên khi bạn chủ động tạo Album."
          }
        }
      }

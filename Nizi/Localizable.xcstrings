    "onboarding.hello.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nizi will survey your photo library to find trips, events, and groups of photos that could become an Album.\n\nAll processing happens on your device.\n\nYou always choose how much of your library to survey."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nizi sẽ khảo sát thư viện ảnh của bạn để tìm các chuyến đi, các sự kiện và những nhóm ảnh có thể trở thành một Album.\n\nToàn bộ dữ liệu được xử lý trên thiết bị của bạn.\n\nBạn luôn có quyền lựa chọn phạm vi khảo sát."
          }
        }
      }
    },
    "onboarding.hello.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello Nizi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello Nizi"
          }
        }
      }
    },
